# --- App ---
APP_NAME=TrustGuard AI
ENV=development
SECRET_KEY=replace_this_with_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (matches docker-compose.yml defaults) ---
DATABASE_URL=postgresql://trustguard:trustguard_dev_password@localhost:5432/trustguard

# --- Redis (matches docker-compose.yml defaults) ---
REDIS_URL=redis://localhost:6379/0

# --- LLM (used from Day 3 onward — Gemini FREE tier only) ---
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_free_gemini_api_key_here
# "gemini-flash-latest" always points to Google's current recommended
# free-tier Flash model, so it keeps working as Google deprecates
# specific dated versions. If you want to pin an exact model instead,
# check https://ai.google.dev/gemini-api/docs/models for what's
# currently available on the free tier before hardcoding one.
GEMINI_MODEL=gemini-flash-latest
